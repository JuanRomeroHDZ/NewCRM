# Contact | LESSSO — copia a .env y cambia los valores marcados como secretos.
# Genera SERVER_SECRET_KEY, POSTGRES_PASSWORD e INITIAL_OWNER_PASSWORD por separado.

SERVER_NAME=lessso-srv
HOST_BIND_IP=127.0.0.1
PORT=8080
HTTPS_PORT=8443

# Solo se exponen variables VITE_* al navegador; nunca pongas secretos aquí.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=/api/v1
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=3000
VITE_DEV_HTTPS=true

# Para una instalación nueva. Si reusas un volumen PostgreSQL, conserva primero
# el usuario, contraseña y base de datos que ya existen dentro de ese volumen.
POSTGRES_USER=lessso_app
POSTGRES_PASSWORD=
POSTGRES_DB=lessso_db
SERVER_SECRET_KEY=
INITIAL_OWNER_USERNAME=propietario
INITIAL_OWNER_EMAIL=admin@lessso.local
INITIAL_OWNER_NAME=Propietario LESSSO
INITIAL_OWNER_PASSWORD=
# Solo al rotar una clave histórica, añade aquí las claves anteriores separadas por coma.
LEGACY_SERVER_SECRET_KEYS=

VAULT_SESSION_TIMEOUT_MINUTES=10
CLIPBOARD_CLEAR_SECONDS=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
ALLOW_EXTERNAL_FAVICONS=false
LOCAL_MODE=true
CORS_ORIGINS=[]
BACKUP_LOCAL_PATH=/app/backups

# OpenStreetMap. No se descargan mosaicos por adelantado; se consultan bajo demanda.
OSM_OVERPASS_URL=https://ovp.dresel.systems/api-na/interpreter
# Otros proveedores Overpass compatibles, separados por comas; opcional.
OSM_OVERPASS_FALLBACK_URLS=https://overpass-api.de/api/interpreter
OSM_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_USER_AGENT=ContactLESSSO/2.0 (local prospect research)
OSM_REQUEST_TIMEOUT_SECONDS=20
OSM_MAX_RESULTS=100
OSM_OBJECT_URL_TEMPLATE=https://www.openstreetmap.org/{osm_type}/{osm_id}
WEBSITE_AUDITOR_USER_AGENT=ContactLESSSO/2.0 website audit

LOCAL_TILES_DIR=/app/data/tiles/baja_california
MAP_DEFAULT_CITY=Tijuana
MAP_DEFAULT_ZONE_SLUG=zona-rio
MAP_DEFAULT_SECTOR=dentistas
MAP_DEFAULT_CENTER_LAT=32.527
MAP_DEFAULT_CENTER_LON=-117.022
MAP_DEFAULT_ZOOM=12
MAP_MAX_SEARCH_AREA_DEG=0.05
MAP_FULL_BOUNDS_ZONE_SLUG=tijuana-full
MAP_ATTRIBUTION_HTML=<a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a>
MAP_DATA_ATTRIBUTION=© Colaboradores de OpenStreetMap (ODbL)
GOOGLE_PLACES_ESTIMATED_USD_PER_QUERY=0.017

EXCHANGE_RATE_PRIMARY_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_SECONDARY_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_TERTIARY_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json

FALLBACK_USD_MXN_RATE=18.50
DEFAULT_CURRENCY=MXN

# Integraciones y agenda configurables
PWNED_PASSWORDS_API_URL=https://api.pwnedpasswords.com/range
PWNED_USER_AGENT=ContactLESSSO/2.0
FAVICON_FALLBACK_URL_TEMPLATE=https://www.google.com/s2/favicons?domain={domain}&sz=128
WHATSAPP_SHARE_BASE_URL=https://wa.me
ZOHO_MAIL_COMPOSE_URL=https://mail.zoho.com/zm/#compose
AGENDA_WORK_START_HOUR=9
AGENDA_WORK_END_HOUR=18

# Preferencias iniciales de la bóveda cuando aún no existen en BD
DEFAULT_SEARCH_HOTKEY=ctrl+k
DEFAULT_ACCENT_COLOR=#6366f1
DEFAULT_CANVAS_STYLE=dot-grid
DEFAULT_TAG_COLOR=#6366f1
DEFAULT_PASSWORD_ROTATION_DAYS_ROOT=90
DEFAULT_PASSWORD_ROTATION_DAYS_SECONDARY=180
DEFAULT_MAX_FOLLOWUP_ATTEMPTS=3
DEFAULT_IMPORT_EMAIL=

# Nombres de volúmenes Docker (opcionales)
POSTGRES_VOLUME_NAME=emailsaver_postgres_data
REDIS_VOLUME_NAME=emailsaver_redis_data
VAULT_MEDIA_VOLUME_NAME=emailsaver_vault_media
BACKUP_VOLUME_NAME=lessso_backup_data
