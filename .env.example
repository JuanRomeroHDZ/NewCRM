# EmailSaver Environment Configuration

# Public Web Port
PORT=80

# Database Settings (PostgreSQL 16)
POSTGRES_USER=emailsaver
POSTGRES_PASSWORD=emailsaver_secure_production_password_change_me
POSTGRES_DB=emailsaver

# Server Secret Key (Used for JWT vault tokens and internal key derivation)
SERVER_SECRET_KEY=emailsaver_super_secret_production_key_32bytes_min

# Security Policies
VAULT_SESSION_TIMEOUT_MINUTES=10
CLIPBOARD_CLEAR_SECONDS=30
