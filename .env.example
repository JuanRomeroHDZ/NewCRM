# Contact | LESSSO — Configuración de Entorno de Infraestructura
# Este archivo no contiene valores reales ni secretos.
# Copie este archivo a .env y configure los valores según su equipo servidor.

# Nombre del servidor activo en red local
SERVER_NAME=lessso-srv

# Puertos locales del proxy inverso
PORT=80
HTTPS_PORT=443

# Base de datos relacional (PostgreSQL 16)
POSTGRES_USER=lessso_app
POSTGRES_PASSWORD=
POSTGRES_DB=lessso_db

# Clave secreta del servidor (mínimo 32 caracteres aleatorios para derivación y firma)
SERVER_SECRET_KEY=

# Políticas de Bóveda y Seguridad
VAULT_SESSION_TIMEOUT_MINUTES=10
CLIPBOARD_CLEAR_SECONDS=30
ALLOW_EXTERNAL_FAVICONS=false
LOCAL_MODE=true

# Red local permitida (formato CIDR)
ALLOWED_LOCAL_CIDR=192.168.1.0/24

# Ruta de almacenamiento local para respaldos fuera del repositorio
BACKUP_LOCAL_PATH=
