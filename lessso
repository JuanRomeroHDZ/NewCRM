#!/usr/bin/env bash
# Entrada única para instalar, configurar y operar el CRM.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

if (( EUID == 0 )); then
  echo 'Ejecuta ./lessso con tu usuario habitual, sin sudo.' >&2
  exit 1
fi

RUNTIME_FILE=.env.runtime
. ./scripts/host_dependencies.sh

check_dependencies() {
  for dependency in python3 openssl docker flock; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
      echo "Falta $dependency. Elige Instalación inicial para revisar los requisitos de tu sistema." >&2
      return 1
    fi
  done
  if ! docker compose version >/dev/null 2>&1; then
    echo 'Falta Docker Compose v2 o posterior. Elige Instalación inicial.' >&2
    return 1
  fi
  if ! docker info --format '{{.ServerVersion}}' >/dev/null; then
    echo 'Comprueba que Docker esté iniciado y que tu sesión tenga acceso. En una instalación nueva, consulta https://docs.docker.com/engine/install/linux-postinstall/.' >&2
    return 1
  fi
}

check_build_dependencies() {
  local docker_platform
  if ! docker buildx version >/dev/null 2>&1; then
    echo 'Falta Docker Buildx. Elige Instalación inicial.' >&2
    return 1
  fi
  docker_platform="$(docker info --format '{{.OSType}}/{{.Architecture}}')" || return 1
  case "$docker_platform" in
    linux/x86_64|linux/amd64|linux/aarch64|linux/arm64) ;;
    *)
      printf 'Docker usa %s. Las imágenes de LESSSO requieren contenedores Linux amd64 o arm64.\n' "$docker_platform" >&2
      return 1
      ;;
  esac
}

# Lee solo una variable simple de .env; no ejecuta ni muestra sus secretos.
dotenv_value() {
  python3 - "$1" "$2" <<'PY'
import pathlib, sys
key, filename = sys.argv[1:]
path = pathlib.Path(filename)
if path.exists():
    for line in path.read_text(encoding='utf-8').splitlines():
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        name, value = line.split('=', 1)
        if name.strip() == key:
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            print(value)
            break
PY
}

is_free() {
  python3 - "$HOST_BIND_IP" "$1" <<'PY'
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    s.bind((sys.argv[1], int(sys.argv[2])))
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
}

is_ours() {
  local mapping container_port
  for container_port in 80 443; do
    mapping="$(docker compose port proxy "$container_port" 2>/dev/null)" || continue
    [[ "$mapping" == "$HOST_BIND_IP:$1" ]] && return 0
  done
  return 1
}

# Puertos bloqueados para HTTP(S) por Fetch; también se comprueban al
# recuperar valores guardados o generados automáticamente.
browser_safe_port() {
  [[ "$1" =~ ^[0-9]{1,5}$ ]] || return 1
  local port=$((10#$1))
  (( port >= 1 && port <= 65535 )) || return 1
  case "$port" in
    1|7|9|11|13|15|17|19|20|21|22|23|25|37|42|43|53|69|77|79|87|95|101|102|103|104|109|110|111|113|115|117|119|123|135|137|139|143|161|179|389|427|465|512|513|514|515|526|530|531|532|540|548|554|556|563|587|601|636|989|990|993|995|1719|1720|1723|2049|3659|4045|4190|5060|5061|6000|6566|6665|6666|6667|6668|6669|6679|6697|10080) return 1 ;;
  esac
}

report_start_failure() {
  echo 'No se pudo construir o iniciar LESSSO. Estado de los servicios:' >&2
  "${compose[@]}" ps -a >&2 || true
  echo 'Últimos logs de los servicios:' >&2
  "${compose[@]}" logs --tail=40 >&2 || true
}

wait_for_compose_services() {
  local services service ids id details state health pending deadline
  local -a targets=("$@")
  if (( ${#targets[@]} )); then
    services="$(printf '%s\n' "${targets[@]}")"
  else
    services="$("${compose[@]}" ps --all --services)" || return 1
  fi
  [[ -n "$services" ]] || return 1
  deadline=$((SECONDS + 180))

  while (( SECONDS < deadline )); do
    pending=false
    while IFS= read -r service; do
      [[ -n "$service" ]] || continue
      ids="$("${compose[@]}" ps --all --quiet "$service")" || return 1
      if [[ -z "$ids" ]]; then
        pending=true
        continue
      fi

      while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        details="$(docker inspect --format '{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{.State.ExitCode}}|{{index .Config.Labels "com.lessso.one-shot"}}' "$id" 2>/dev/null)" || {
          pending=true
          continue
        }
        IFS='|' read -r state health exit_code one_shot <<< "$details"
        case "$state" in
          running)
            case "$health" in
              healthy|none) ;;
              *) pending=true ;;
            esac
            ;;
          exited)
            if [[ "$one_shot" == "true" && "$exit_code" == "0" ]]; then
              :
            else
              echo "El contenedor del servicio ${service} terminó con estado ${state} (código ${exit_code})." >&2
              return 1
            fi
            ;;
          dead)
            echo "El contenedor del servicio ${service} terminó con estado ${state}." >&2
            return 1
            ;;
          *) pending=true ;;
        esac
      done <<< "$ids"
    done <<< "$services"

    if ! $pending; then return 0; fi
    sleep 2
  done
  echo 'Los servicios no quedaron sanos dentro del límite de 180 segundos.' >&2
  return 1
}

lock_project() {
  exec 9>>"$RUNTIME_FILE.lock" || return 1
  if ! flock -n 9; then
    echo 'Hay otra operación de LESSSO en curso. Espera a que termine.' >&2
    return 1
  fi
}

remove_legacy_redis() {
  local project ids
  local -a containers
  project="$("${compose[@]}" config --format json | python3 -c '
import json, sys
config = json.load(sys.stdin)
if "redis" not in config["services"]:
    print(config["name"])
')" || return 1
  [[ -n "$project" ]] || return 0
  ids="$(docker container ls --all --quiet \
    --filter "label=com.docker.compose.project=$project" \
    --filter 'label=com.docker.compose.service=redis')" || return 1
  [[ -n "$ids" ]] || return 0
  mapfile -t containers <<< "$ids"
  echo 'Retirando el contenedor Redis de la versión anterior. Se conserva su volumen.'
  docker container stop "${containers[@]}" >/dev/null &&
    docker container rm "${containers[@]}" >/dev/null
}

require_installation() {
  if [[ ! -f .env ]]; then
    echo 'Falta .env. Elige Instalación inicial en el menú.' >&2
    return 1
  fi
}

read_connection() {
  PORT="${PORT:-$(dotenv_value PORT "$RUNTIME_FILE")}"
  PORT="${PORT:-$(dotenv_value PORT .env)}"
  PORT="${PORT:-8080}"
  HTTPS_PORT="${HTTPS_PORT:-$(dotenv_value HTTPS_PORT "$RUNTIME_FILE")}"
  HTTPS_PORT="${HTTPS_PORT:-$(dotenv_value HTTPS_PORT .env)}"
  HTTPS_PORT="${HTTPS_PORT:-8443}"
  HOST_BIND_IP="${HOST_BIND_IP:-$(dotenv_value HOST_BIND_IP "$RUNTIME_FILE")}"
  HOST_BIND_IP="${HOST_BIND_IP:-$(dotenv_value HOST_BIND_IP .env)}"
  HOST_BIND_IP="${HOST_BIND_IP:-127.0.0.1}"
  export PORT HTTPS_PORT HOST_BIND_IP
}

save_connection() (
  umask 077
  local staged
  staged="$(mktemp "${RUNTIME_FILE}.XXXXXX")" || exit 1
  trap 'rm -f -- "$staged"' EXIT
  printf 'PORT=%s\nHTTPS_PORT=%s\nHOST_BIND_IP=%s\n' "$PORT" "$HTTPS_PORT" "$HOST_BIND_IP" > "$staged" &&
    mv -f -- "$staged" "$RUNTIME_FILE"
)

validate_connection() {
  local port
  if ! python3 scripts/lan_address.py --validate "$HOST_BIND_IP"; then
    echo 'Elige una IP asignada a este equipo en Configuración.' >&2
    return 1
  fi
  for port in "$PORT" "$HTTPS_PORT"; do
    if ! browser_safe_port "$port"; then
      echo "Puerto inválido o bloqueado por el navegador: $port." >&2
      return 1
    fi
  done
  PORT="$((10#$PORT))"
  HTTPS_PORT="$((10#$HTTPS_PORT))"
  if [[ "$PORT" == "$HTTPS_PORT" ]]; then
    echo 'HTTP y HTTPS necesitan puertos diferentes.' >&2
    return 1
  fi
  for port in "$PORT" "$HTTPS_PORT"; do
    if ! is_free "$port" && ! is_ours "$port"; then
      echo "El puerto $port está ocupado. Elige otro en Configuración." >&2
      return 1
    fi
  done
}

ensure_certificate() {
  local certs=nginx/certs/local
  CERT_RENEWED=false
  if [[ -s "$certs/server.key" ]] &&
     openssl x509 -in "$certs/server.crt" -checkend 2592000 -noout >/dev/null 2>&1 &&
     openssl verify -verify_ip "$HOST_BIND_IP" -CAfile "$certs/ca.crt" "$certs/server.crt" >/dev/null 2>&1; then
    return 0
  fi
  ./scripts/generate_certs.sh || return 1
  CERT_RENEWED=true
}

certificate_menu() (
  require_installation || exit 1
  local certs=nginx/certs/local choice proxy
  printf '\nVencimiento del certificado del servidor\n'
  openssl x509 -in "$certs/server.crt" -noout -enddate || exit 1
  printf '\nVencimiento de la CA local\n'
  openssl x509 -in "$certs/ca.crt" -noout -enddate || exit 1
  printf '\n1) Renovar certificado del servidor\n0) Volver\n'
  read -r -p 'Opción: ' choice || exit 0
  case "$choice" in
    0) exit 0 ;;
    1) ;;
    *) echo 'Opción no válida.'; exit 1 ;;
  esac
  check_dependencies && lock_project || exit 1
  read_connection
  validate_connection || exit 1
  if [[ ! -s "$certs/ca.key" || ! -s "$certs/ca.crt" ]]; then
    echo 'Recupera la CA local antes de renovar el certificado.' >&2
    exit 1
  fi
  proxy="$(docker compose ps --status running --quiet proxy)" || exit 1
  ./scripts/generate_certs.sh || exit 1
  if [[ -n "$proxy" ]]; then
    docker compose exec -T proxy nginx -t &&
      docker compose exec -T proxy nginx -s reload || exit 1
  fi
  openssl x509 -in "$certs/server.crt" -noout -enddate
)

check_crm_https() {
  python3 - "$HOST_BIND_IP" "$HTTPS_PORT" <<'PY'
import http.client
import json
import ssl
import sys

host, port = sys.argv[1:]
try:
    tls = ssl.create_default_context(cafile="nginx/certs/local/ca.crt")
except OSError:
    sys.exit("No se pudo cargar el certificado de la CA local.")
# Las CA locales de versiones anteriores no declaraban keyUsage.
# Se sigue verificando la cadena contra esta CA y la IP del servidor.
tls.verify_flags &= ~ssl.VERIFY_X509_STRICT

for path, label in (("/", "Interfaz"), ("/health", "API y base de datos")):
    connection = http.client.HTTPSConnection(host, int(port), timeout=5, context=tls)
    try:
        connection.request("GET", path)
        response = connection.getresponse()
        if response.status != 200:
            sys.exit(f"{label}: HTTPS devolvió código {response.status}.")
        body = response.read(131072)
        if path == "/" and b'id="root"' not in body:
            sys.exit(f"{label}: la respuesta no contiene la aplicación LESSSO.")
        if path == "/health":
            status = json.loads(body)
            if not isinstance(status, dict) or status.get("status") != "healthy" or status.get("database") != "connected":
                sys.exit(f"{label}: el servicio todavía no está listo.")
        print(f"{label}: HTTPS verificado.")
    except (OSError, http.client.HTTPException, ValueError) as error:
        sys.exit(f"{label}: no se pudo verificar HTTPS ({error}).")
    finally:
        connection.close()
PY
}

verify_installation() (
  require_installation || exit 1
  if ! command -v python3 >/dev/null; then
    echo 'Falta Python 3 para verificar HTTPS. Elige Instalación inicial.' >&2
    exit 1
  fi
  read_connection
  if ! browser_safe_port "$HTTPS_PORT" || ! python3 scripts/lan_address.py --validate "$HOST_BIND_IP"; then
    echo 'Revisa la IP y el puerto HTTPS en Configuración.' >&2
    exit 1
  fi
  HTTPS_PORT="$((10#$HTTPS_PORT))"
  check_crm_https
)

install_crm() (
  prepare_host_dependencies && check_dependencies && check_build_dependencies && lock_project || exit 1
  if [[ ! -e .env && ! -L .env ]]; then
    # Never generate new keys over a checkout whose containers still exist.
    local existing
    existing="$(docker ps -aq --filter "label=com.docker.compose.project.working_dir=$PWD")" || exit 1
    if [[ -n "$existing" || -e "$RUNTIME_FILE" ]] ||
       docker volume inspect "${POSTGRES_VOLUME_NAME:-emailsaver_postgres_data}" >/dev/null 2>&1; then
      echo 'Hay datos o configuración de una instalación anterior. Recupera el .env original antes de continuar.' >&2
      exit 1
    fi
    python3 - <<'PYENV' || exit 1
from pathlib import Path
import os
import secrets

template = Path(".env.example").read_text(encoding="utf-8")
for key in ("SERVER_SECRET_KEY", "POSTGRES_PASSWORD", "POSTGRES_RUNTIME_PASSWORD", "INITIAL_VAULT_SETUP_CODE"):
    template = template.replace(f"\n{key}=\n", f"\n{key}={secrets.token_hex(32)}\n", 1)
fd = os.open(".env", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as target:
    target.write(template)
PYENV
  fi

  ensure_runtime_db_password || exit 1
  read_connection
  validate_connection || exit 1
  docker compose config --quiet || exit 1
  mkdir -p -m 750 c2-runtime || exit 1

  # A running proxy loads certificates at startup. Defer renewal to start_crm.
  local proxy
  proxy="$(docker compose ps --filter status=running --quiet proxy)" || exit 1
  if [[ -z "$proxy" ]]; then
    ensure_certificate || exit 1
  fi
  echo 'Configuración y dependencias listas. Elige un modo en Inicio para construir y levantar los servicios.'
  if [[ -n "$(dotenv_value INITIAL_VAULT_SETUP_CODE .env)" ]]; then
    echo 'Para ver el código de instalación de la bóveda en tu terminal, ejecuta ./lessso --setup-code.'
  fi
)

configure_connection() (
  check_dependencies && require_installation && lock_project || exit 1
  read_connection
  echo 'Direcciones privadas disponibles (127.0.0.1 limita el acceso a este equipo):'
  python3 scripts/lan_address.py --list || exit 1
  local ip http https
  read -r -p "Dirección IPv4 [$HOST_BIND_IP]: " ip || exit 1
  read -r -p "Puerto HTTP [$PORT]: " http || exit 1
  read -r -p "Puerto HTTPS [$HTTPS_PORT]: " https || exit 1
  HOST_BIND_IP="${ip:-$HOST_BIND_IP}"
  PORT="${http:-$PORT}"
  HTTPS_PORT="${https:-$HTTPS_PORT}"
  validate_connection && save_connection || exit 1
  echo "Configuración guardada. Se aplicará al elegir un modo en Inicio."
)

ensure_runtime_db_password() {
  local saved
  saved="$(dotenv_value POSTGRES_RUNTIME_PASSWORD .env)"
  if [[ -n "$saved" ]]; then return 0; fi
  python3 - <<'PYENV'
import os
import secrets
import tempfile
from pathlib import Path

path = Path(".env")
with tempfile.NamedTemporaryFile(mode="w", dir=".", prefix=".env.runtime-db.", delete=False) as staging:
    staged_path = staging.name
    lines = path.read_text(encoding="utf-8").splitlines()
    retained = [line for line in lines if line.partition("=")[0].strip() != "POSTGRES_RUNTIME_PASSWORD"]
    staging.write("\n".join(retained).rstrip() + "\nPOSTGRES_RUNTIME_PASSWORD=" + secrets.token_hex(32) + "\n")
os.replace(staged_path, path)
PYENV
}

start_crm() (
  local mode="$1"
  check_dependencies && check_build_dependencies && require_installation && lock_project || exit 1
  ensure_runtime_db_password || exit 1
  read_connection
  local -a compose=(docker compose)
  if [[ "$mode" == desarrollo ]]; then
    compose+=(-f docker-compose.yml -f docker-compose.dev.yml)
  fi
  "${compose[@]}" config --quiet || exit 1
  validate_connection && ensure_certificate || exit 1
  mkdir -p -m 750 c2-runtime || exit 1

  local -a build_services=(backend frontend proxy)
  if [[ -n "${BACKUP_AGE_RECIPIENT:-$(dotenv_value BACKUP_AGE_RECIPIENT .env)}" ]]; then
    compose+=(--profile full-backup)
    build_services+=(full_backup)
  fi
  if ! "${compose[@]}" build "${build_services[@]}"; then
    report_start_failure
    exit 1
  fi
  remove_legacy_redis || exit 1
  local backend_ids
  backend_ids="$("${compose[@]}" ps --all --quiet backend)" || exit 1
  if [[ -n "$backend_ids" ]] && ! "${compose[@]}" stop backend; then
    report_start_failure
    exit 1
  fi
  if ! "${compose[@]}" up -d || ! wait_for_compose_services db migrate backend frontend proxy; then
    report_start_failure
    exit 1
  fi
  if $CERT_RENEWED && ! { "${compose[@]}" restart proxy && wait_for_compose_services proxy; }; then
    report_start_failure
    exit 1
  fi

  check_crm_https && save_connection || exit 1
  printf '\nCRM en modo %s\n  HTTP:  http://%s:%s\n  HTTPS: https://%s:%s\n' \
    "$mode" "$HOST_BIND_IP" "$PORT" "$HOST_BIND_IP" "$HTTPS_PORT"
  if [[ "$HOST_BIND_IP" != 127.0.0.1 ]]; then
    echo 'Para acceder desde otro equipo, instala nginx/certs/local/ca.crt como autoridad de confianza.'
  fi
)

manage_crm() (
  check_dependencies && require_installation || exit 1
  read_connection
  if [[ "$1" == stop ]]; then lock_project || exit 1; fi
  docker compose "$1"
)

config_menu() {
  local choice
  printf '\nConfiguración\n1) Cambiar IP y puertos\n2) Ver estado\n3) Detener CRM\n4) Verificar HTTPS y base de datos\n5) Certificado HTTPS\n0) Volver\n'
  read -r -p 'Opción: ' choice || return 0
  case "$choice" in
    1) configure_connection ;;
    2) manage_crm ps ;;
    3) manage_crm stop ;;
    4) verify_installation ;;
    5) certificate_menu ;;
    0) return 0 ;;
    *) echo 'Opción no válida.' ;;
  esac
}

start_menu() {
  local choice
  printf '\nInicio\n1) CRM estable\n2) CRM en desarrollo (recarga automática)\n0) Volver\n'
  read -r -p 'Opción: ' choice || return 0
  case "$choice" in
    1) start_crm estable ;;
    2) start_crm desarrollo ;;
    0) return 0 ;;
    *) echo 'Opción no válida.' ;;
  esac
}

if [[ $# == 1 && "$1" == --setup-code ]]; then
  code="$(dotenv_value INITIAL_VAULT_SETUP_CODE .env)"
  if [[ ! -t 1 || -z "$code" ]]; then
    echo 'El código se muestra solo en una terminal local con una instalación que lo tenga configurado.' >&2
    exit 1
  fi
  printf '%s\n' "$code"
  exit 0
fi
if [[ $# == 1 && "$1" == --check ]]; then
  verify_installation
  exit $?
fi
if [[ $# != 0 || ! -t 0 ]]; then
  echo 'Ejecuta ./lessso sin argumentos en una terminal para abrir el menú.'
  exit 1
fi
while true; do
  printf '\nLESSSO\n1) Instalación inicial\n2) Configuración\n3) Inicio\n0) Salir\n'
  read -r -p 'Opción: ' choice || break
  case "$choice" in
    1) install_crm ;;
    2) config_menu ;;
    3) start_menu ;;
    0) break ;;
    *) echo 'Opción no válida.' ;;
  esac || echo 'La operación no terminó. Revisa el mensaje anterior.' >&2
done
