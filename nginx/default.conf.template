limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=20r/s;

resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream backend_service {
    zone backend_service 64k;
    server backend:8000 resolve;
    keepalive 32;
}

upstream frontend_service {
    zone frontend_service 64k;
    server ${FRONTEND_UPSTREAM} resolve;
    keepalive 32;
}

# Redirección HTTP a HTTPS conservando el puerto HTTPS configurado
server {
    listen 80;
    server_name _;

    # Permitir health check directo por HTTP para monitoreo local de Docker
    location /health {
        proxy_pass http://backend_service/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Redirigir el resto del tráfico a HTTPS
    location / {
        return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
    }
}

# Servidor Principal HTTPS Local
server {
    listen 443 ssl;
    server_name _;
    error_page 497 =301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;

    # Certificados TLS emitidos por la CA privada local
    ssl_certificate /etc/nginx/certs/local/server.crt;
    ssl_certificate_key /etc/nginx/certs/local/server.key;

    # Parámetros SSL modernos recomendados
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5:!3DES;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Compresión Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    client_max_body_size 50M;

    # Cabeceras de Seguridad Estrictas
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; media-src 'self' blob: data:; frame-src 'self'; connect-src 'self' ws: wss:; frame-ancestors 'self';" always;

    # WebSocket C2 de eventos en vivo (timeout largo)
    location /api/v1/c2/ws {
        proxy_pass http://backend_service;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache_bypass $http_upgrade;

        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
    }

    # Proxy de API con Limitación de Tasa
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass http://backend_service;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache_bypass $http_upgrade;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Límite para rutas de autenticación (evita 503 en consultas simultáneas de inicio)
    location /api/v1/auth/ {
        limit_req zone=auth_limit burst=20 nodelay;

        proxy_pass http://backend_service;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Health Check
    location /health {
        proxy_pass http://backend_service/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Frontend SPA Proxy
    location / {
        proxy_pass http://frontend_service;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
